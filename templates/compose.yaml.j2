# Generated by gen.py. Regenerate instead of editing by hand.
name: dnslab

x-node: &node
  image: dnslab:latest
  pull_policy: never
  restart: unless-stopped
  init: true

networks:
  lab:
    ipam:
      config:
        - subnet: 10.53.0.0/16

services:
  root:
    <<: *node
    command: ["auth"]
    cap_add: [NET_ADMIN]
    environment: { NETEM_DELAY: "{{ root_delay }}" }
    volumes: ["./root:/lab:ro"]
    networks: { lab: { ipv4_address: 10.53.0.2 } }

  tld:
    <<: *node
    command: ["auth"]
    cap_add: [NET_ADMIN]
    environment: { NETEM_DELAY: "{{ tld_delay }}" }
    volumes: ["./tld:/lab:ro"]
    networks: { lab: { ipv4_address: 10.53.0.3 } }

  resolver-a:
    <<: *node
    command: ["resolver"]
    volumes: ["./resolver-a:/lab:ro"]
    networks: { lab: { ipv4_address: 10.53.0.53 } }

  resolver-b:
    <<: *node
    command: ["resolver"]
    volumes: ["./resolver-b:/lab:ro"]
    networks: { lab: { ipv4_address: 10.53.0.54 } }

  web-a:
    <<: *node
    command: ["web"]
    volumes: ["./web-a:/lab:ro"]
    networks: { lab: { ipv4_address: 10.53.0.80 } }

  web-b:
    <<: *node
    command: ["web"]
    volumes: ["./web-b:/lab:ro"]
    networks: { lab: { ipv4_address: 10.53.0.81 } }
{% for s in students %}
  {{ s.id }}:
    <<: *node
    command: ["student"]
    hostname: ns-{{ s.id }}
    environment:
      STUDENT_ID: "{{ s.id }}"
      STUDENT_IP: "{{ s.ip }}"
      TTYD_CRED: "{{ s.id }}:{{ s.password }}"
      RESOLVER: "10.53.0.53"
    volumes:
      - "./students/{{ s.id }}/named.conf:/lab/named.conf:ro"
      - "./students/{{ s.id }}/zone:/lab/zone"
    ports: ["{{ bind_addr }}:{{ s.port }}:7681"]
    mem_limit: 128m
    pids_limit: 128
    networks: { lab: { ipv4_address: {{ s.ip }} } }
{% endfor %}
